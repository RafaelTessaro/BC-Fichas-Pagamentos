<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:BCFichas.App.ViewModels"
             xmlns:v="using:BCFichas.App.Views"
             x:Class="BCFichas.App.Views.DevolucaoView"
             x:DataType="vm:DevolucaoViewModel">
  <Grid RowDefinitions="Auto,*">
    <Border Classes="cabecalho">
      <Grid ColumnDefinitions="Auto,*,Auto">
        <Button Classes="fantasma" Command="{Binding VoltarCommand}" Height="48" Padding="12,0">
          <StackPanel Orientation="Horizontal" Spacing="8">
            <PathIcon Data="{StaticResource IconeVoltar}" />
            <TextBlock Text="Voltar" VerticalAlignment="Center" />
          </StackPanel>
        </Button>
        <TextBlock Grid.Column="1" Text="Devolução de fichas" Classes="titulo" VerticalAlignment="Center" Margin="10,0" />
        <Border Grid.Column="2" Classes="selo" Padding="14,6">
          <TextBlock FontSize="16" Foreground="{StaticResource PrimariaEscura}">
            <Run Text="Dinheiro no caixa:" />
            <Run Text="{Binding DinheiroEmCaixa}" FontWeight="Bold" />
          </TextBlock>
        </Border>
      </Grid>
    </Border>

    <Grid Grid.Row="1" ColumnDefinitions="330,*" Margin="10">

      <!-- Achar o pedido pelo número da ficha (ou passando a ficha no leitor de código de barras) -->
      <Border Classes="cartao" Margin="5">
        <StackPanel Spacing="10">
          <TextBlock Text="Número do pedido" Classes="secao" Margin="0" />
          <TextBlock Text="É o número depois de PED: na ficha." Classes="dica" Margin="0,-6,0,0" />
          <TextBox x:Name="CampoBusca" Classes="numero semteclado" Text="{Binding Busca}" FontSize="30" FontWeight="Bold"
                   MaxLength="14" Watermark="Ex.: 13" HorizontalContentAlignment="Center">
            <TextBox.KeyBindings>
              <KeyBinding Gesture="Enter" Command="{Binding BuscarCommand}" />
            </TextBox.KeyBindings>
          </TextBox>
          <v:TecladoNumerico Comando="{Binding TeclaCommand}" TeclaEsquerda="C" Height="250" />
          <Button Classes="primario" Command="{Binding BuscarCommand}" HorizontalAlignment="Stretch" Height="58">
            <StackPanel Orientation="Horizontal" Spacing="10">
              <PathIcon Data="{StaticResource IconeBusca}" Foreground="White" />
              <TextBlock Text="Buscar pedido" Foreground="White" FontSize="19" FontWeight="Bold" />
            </StackPanel>
          </Button>
          <TextBlock Text="Com leitor de código de barras, é só passar a ficha." Classes="dica" TextAlignment="Center" />
        </StackPanel>
      </Border>

      <Border Grid.Column="1" Classes="cartao" Margin="5">
        <Panel>

          <!-- Sem pedido: explicação e devoluções já feitas neste caixa -->
          <Grid IsVisible="{Binding SemPedido}" RowDefinitions="Auto,Auto,*">
            <Border Background="{StaticResource Fundo}" CornerRadius="14" Padding="18">
              <Grid ColumnDefinitions="Auto,*">
                <Border Width="56" Height="56" CornerRadius="14" Background="{StaticResource PrimariaClara}" VerticalAlignment="Top">
                  <PathIcon Data="{StaticResource IconeFicha}" Width="30" Height="30" Foreground="{StaticResource Primaria}" />
                </Border>
                <StackPanel Grid.Column="1" Margin="14,0,0,0" Spacing="6">
                  <TextBlock Text="O cliente não usou uma ficha?" FontSize="19" FontWeight="Bold" />
                  <TextBlock TextWrapping="Wrap" FontSize="15" Classes="suave"
                             Text="Pegue a ficha de volta, busque o pedido e marque o que voltou. A venda continua valendo; só a parte devolvida sai do total." />
                  <TextBlock TextWrapping="Wrap" FontSize="15" Classes="suave"
                             Text="Pago em dinheiro: o valor sai da gaveta. Pago no cartão ou no PIX: o estorno é feito na maquininha (por causa das taxas)." />
                </StackPanel>
              </Grid>
            </Border>
            <TextBlock Grid.Row="1" Text="Devoluções deste caixa" Classes="secao" Margin="0,18,0,6" />
            <Panel Grid.Row="2">
              <TextBlock Text="Nenhuma devolução ainda." Classes="suave" IsVisible="{Binding SemFeitas}" />
              <ScrollViewer>
                <ItemsControl ItemsSource="{Binding Feitas}">
                  <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="vm:DevolucaoFeita">
                      <Border BorderBrush="{StaticResource Borda}" BorderThickness="0,0,0,1" Padding="2,8">
                        <Grid ColumnDefinitions="*,Auto">
                          <StackPanel>
                            <TextBlock FontWeight="SemiBold" FontSize="15">
                              <Run Text="{Binding Hora}" />
                              <Run Text="•" />
                              <Run Text="{Binding Titulo}" />
                              <Run Text="•" />
                              <Run Text="{Binding Como}" />
                            </TextBlock>
                            <TextBlock Text="{Binding Itens}" Classes="suave" FontSize="13" TextTrimming="CharacterEllipsis" />
                          </StackPanel>
                          <TextBlock Grid.Column="1" Text="{Binding Valor}" FontSize="17" FontWeight="Bold"
                                     Foreground="{StaticResource Perigo}" VerticalAlignment="Center" />
                        </Grid>
                      </Border>
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>
              </ScrollViewer>
            </Panel>
          </Grid>

          <!-- Pedido achado: escolher as fichas devolvidas -->
          <Grid IsVisible="{Binding TemPedido}" RowDefinitions="Auto,*,Auto">
            <Grid ColumnDefinitions="*,Auto" Margin="0,0,0,8">
              <StackPanel>
                <TextBlock Text="{Binding PedidoTitulo}" Classes="titulo" />
                <TextBlock Text="{Binding PedidoInfo}" Classes="suave" FontSize="15" TextWrapping="Wrap" />
              </StackPanel>
              <Button Grid.Column="1" Classes="suave" Content="Outro pedido" Command="{Binding OutroPedidoCommand}"
                      VerticalAlignment="Top" />
            </Grid>

            <ScrollViewer Grid.Row="1">
              <ItemsControl ItemsSource="{Binding Itens}">
                <ItemsControl.ItemTemplate>
                  <DataTemplate x:DataType="vm:ItemDevolucao">
                    <Border BorderBrush="{StaticResource Borda}" BorderThickness="0,0,0,1" Padding="4,10"
                            Classes.marcado="{Binding Marcado}" CornerRadius="10" IsEnabled="{Binding PodeDevolver}">
                      <Grid ColumnDefinitions="*,Auto,110">
                        <StackPanel VerticalAlignment="Center">
                          <TextBlock Text="{Binding Nome}" FontWeight="Bold" FontSize="17" TextWrapping="Wrap" />
                          <TextBlock Classes="suave" FontSize="13">
                            <Run Text="{Binding Preco}" />
                            <Run Text="•" />
                            <Run Text="{Binding Situacao}" />
                          </TextBlock>
                        </StackPanel>
                        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" Margin="8,0">
                          <Button Classes="suave" Width="46" Height="46" Padding="0" CornerRadius="999" Command="{Binding MenosCommand}">
                            <PathIcon Data="{StaticResource IconeMenos}" Width="20" Height="20" />
                          </Button>
                          <TextBlock Text="{Binding Quantidade}" FontSize="22" FontWeight="Bold" MinWidth="44"
                                     TextAlignment="Center" VerticalAlignment="Center" />
                          <Button Classes="suave" Width="46" Height="46" Padding="0" CornerRadius="999" Command="{Binding MaisCommand}">
                            <PathIcon Data="{StaticResource IconeMais}" Width="20" Height="20" />
                          </Button>
                        </StackPanel>
                        <TextBlock Grid.Column="2" Text="{Binding Total}" FontSize="18" FontWeight="Bold" TextAlignment="Right"
                                   VerticalAlignment="Center" />
                      </Grid>
                    </Border>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
            </ScrollViewer>

            <StackPanel Grid.Row="2" Spacing="10" Margin="0,10,0,0">
              <TextBox Text="{Binding Motivo}" Watermark="Motivo (opcional). Ex.: acabou o pastel" MaxLength="60" />
              <Border Classes="instrucao" CornerRadius="14" Padding="16,12" Classes.maquininha="{Binding NaMaquininha}">
                <Grid ColumnDefinitions="*,Auto">
                  <StackPanel VerticalAlignment="Center" Margin="0,0,12,0">
                    <TextBlock FontSize="14" FontWeight="Bold">
                      <Run Text="A DEVOLVER •" />
                      <Run Text="{Binding FormaTexto}" />
                    </TextBlock>
                    <TextBlock Text="{Binding Instrucao}" FontSize="15" TextWrapping="Wrap" />
                  </StackPanel>
                  <TextBlock Grid.Column="1" Text="{Binding TotalTexto}" FontSize="36" FontWeight="ExtraBold"
                             VerticalAlignment="Center" />
                </Grid>
              </Border>
              <CheckBox IsVisible="{Binding NaMaquininha}" IsChecked="{Binding EstornoFeito}" FontSize="17">
                <TextBlock Text="Já fiz o estorno na maquininha de cartão" FontSize="17" FontWeight="SemiBold" />
              </CheckBox>
              <Button Classes="perigo" Command="{Binding RegistrarCommand}" IsEnabled="{Binding PodeRegistrar}"
                      HorizontalAlignment="Stretch" Height="62">
                <StackPanel Orientation="Horizontal" Spacing="10">
                  <PathIcon Data="{StaticResource IconeTroca}" Foreground="White" Width="24" Height="24" />
                  <TextBlock Text="Registrar devolução e imprimir comprovante" Foreground="White" FontSize="19" FontWeight="Bold" />
                </StackPanel>
              </Button>
            </StackPanel>
          </Grid>
        </Panel>
      </Border>
    </Grid>
  </Grid>

  <UserControl.Styles>
    <Style Selector="Border.marcado">
      <Setter Property="Background" Value="{StaticResource PerigoClara}" />
    </Style>
    <Style Selector="Border.instrucao">
      <Setter Property="Background" Value="{StaticResource PrimariaClara}" />
    </Style>
    <Style Selector="Border.instrucao.maquininha">
      <Setter Property="Background" Value="#DBEAFE" />
    </Style>
    <Style Selector="Border:disabled">
      <Setter Property="Opacity" Value="0.5" />
    </Style>
  </UserControl.Styles>
</UserControl>
