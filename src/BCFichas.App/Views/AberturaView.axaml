<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:BCFichas.App.ViewModels"
             xmlns:v="using:BCFichas.App.Views"
             x:Class="BCFichas.App.Views.AberturaView"
             x:DataType="vm:AberturaViewModel">
  <Grid RowDefinitions="60,*">
    <Border Background="{StaticResource Escuro}" Padding="18,0,8,0">
      <Grid ColumnDefinitions="Auto,*,Auto,Auto">
        <Image Source="/Assets/icone.png" Width="36" Height="36" />
        <TextBlock Grid.Column="1" Text="{Binding NomeEvento}" Foreground="White" FontSize="22" FontWeight="Bold"
                   VerticalAlignment="Center" Margin="12,0" TextTrimming="CharacterEllipsis" />
        <Button Grid.Column="2" Classes="topo" Command="{Binding ConfigurarCommand}" Padding="14,0">
          <StackPanel Orientation="Horizontal" Spacing="8">
            <PathIcon Data="{StaticResource IconeConfig}" Foreground="White" />
            <TextBlock Text="Configurações" Foreground="White" VerticalAlignment="Center" />
          </StackPanel>
        </Button>
        <Button Grid.Column="3" Classes="topo" Command="{Binding SairCommand}" Padding="14,0">
          <StackPanel Orientation="Horizontal" Spacing="8">
            <PathIcon Data="{StaticResource IconeDesligar}" Foreground="White" />
            <TextBlock Text="Sair" Foreground="White" VerticalAlignment="Center" />
          </StackPanel>
        </Button>
      </Grid>
    </Border>

    <ScrollViewer Grid.Row="1">
      <Border Classes="cartao" MaxWidth="820" Margin="20" Padding="26" VerticalAlignment="Center">
        <Grid ColumnDefinitions="*,300" RowDefinitions="Auto,*,Auto">
          <StackPanel Grid.ColumnSpan="2" Orientation="Horizontal" Spacing="14" Margin="0,0,0,10">
            <Border Width="52" Height="52" CornerRadius="14" Background="{StaticResource PrimariaClara}">
              <PathIcon Data="{StaticResource IconeLoja}" Width="28" Height="28" Foreground="{StaticResource Primaria}" />
            </Border>
            <StackPanel VerticalAlignment="Center">
              <TextBlock Classes="titulo">
                <Run Text="Abrir o" />
                <Run Text="{Binding Caixa}" />
              </TextBlock>
              <TextBlock Text="Informe quem vai trabalhar no caixa e o troco que está na gaveta." Classes="suave" />
            </StackPanel>
          </StackPanel>

          <StackPanel Grid.Row="1" Margin="0,0,24,0">
            <TextBlock Text="Nome do operador" Classes="rotulo" />
            <TextBox Text="{Binding Operador}" Watermark="Ex.: MARIA" MaxLength="30" />
            <TextBlock Text="Troco inicial (fundo de caixa)" Classes="rotulo" Margin="2,18,0,4" />
            <Border Background="{StaticResource Fundo}" CornerRadius="12" Padding="16,8">
              <TextBlock Text="{Binding Troco.Texto}" FontSize="38" FontWeight="ExtraBold" TextAlignment="Right" />
            </Border>
            <TextBlock Text="Digite só os números: 5, 0, 0, 0 vira R$ 50,00." Classes="dica" />
          </StackPanel>

          <v:TecladoNumerico Grid.Row="1" Grid.Column="1" Comando="{Binding Troco.TeclaCommand}" TeclaEsquerda="C" />

          <Button Grid.Row="2" Grid.ColumnSpan="2" Classes="primario" Command="{Binding AbrirCaixaCommand}"
                  HorizontalAlignment="Stretch" Height="66" Margin="0,22,0,0" CornerRadius="14">
            <StackPanel Orientation="Horizontal" Spacing="12">
              <PathIcon Data="{StaticResource IconeLoja}" Width="26" Height="26" Foreground="White" />
              <TextBlock Text="Abrir caixa" FontSize="22" FontWeight="ExtraBold" Foreground="White" />
            </StackPanel>
          </Button>
        </Grid>
      </Border>
    </ScrollViewer>
  </Grid>
</UserControl>
