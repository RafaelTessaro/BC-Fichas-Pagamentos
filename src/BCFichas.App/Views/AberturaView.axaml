<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:BCFichas.App.ViewModels"
             xmlns:v="using:BCFichas.App.Views"
             x:Class="BCFichas.App.Views.AberturaView"
             x:DataType="vm:AberturaViewModel">
  <Grid ColumnDefinitions="320,*">

    <!-- Lado escuro com a marca da BC Fichas -->
    <Border Background="{StaticResource FundoLateral}" BorderBrush="{StaticResource MarcaBorda}" BorderThickness="0,0,1,0">
      <Grid RowDefinitions="*,Auto,Auto" Margin="22,26,22,18">
        <StackPanel VerticalAlignment="Center" Spacing="18">
          <!-- 5 toques seguidos no logo: modo teste -->
          <Button Classes="marca" Command="{Binding ToqueNaMarcaCommand}" Focusable="False">
            <v:MarcaBC Tamanho="104" />
          </Button>
          <TextBlock Text="{Binding NomeEvento}" Foreground="White" FontSize="24" FontWeight="Bold"
                     TextAlignment="Center" TextWrapping="Wrap" MaxLines="3" />
          <Border Background="{StaticResource Primaria}" CornerRadius="10" Padding="16,6" HorizontalAlignment="Center">
            <TextBlock Text="{Binding Caixa}" Foreground="White" FontWeight="Bold" FontSize="17" />
          </Border>
          <StackPanel>
            <TextBlock Text="{Binding Principal.Relogio}" Foreground="White" FontSize="40" FontWeight="Bold"
                       HorizontalAlignment="Center" />
            <TextBlock Text="{Binding Principal.Data}" Foreground="{StaticResource MarcaTextoSuave}" FontSize="15"
                       HorizontalAlignment="Center" />
          </StackPanel>
        </StackPanel>

        <UniformGrid Grid.Row="1" Columns="2" Margin="0,0,0,14">
          <Button Classes="lateral" Command="{Binding ConfigurarCommand}" Height="64" Margin="0,0,5,0">
            <StackPanel Spacing="3">
              <PathIcon Data="{StaticResource IconeConfig}" Foreground="White" />
              <TextBlock Text="Configurações" Foreground="White" FontSize="13" HorizontalAlignment="Center" />
            </StackPanel>
          </Button>
          <Button Classes="lateral" Command="{Binding SairCommand}" Height="64" Margin="5,0,0,0">
            <StackPanel Spacing="3">
              <PathIcon Data="{StaticResource IconeDesligar}" Foreground="White" />
              <TextBlock Text="Sair" Foreground="White" FontSize="13" HorizontalAlignment="Center" />
            </StackPanel>
          </Button>
        </UniformGrid>
        <StackPanel Grid.Row="2" Spacing="2">
          <TextBlock Text="{Binding Principal.Suporte}" Foreground="{StaticResource Marca}" FontSize="13" FontWeight="SemiBold"
                     HorizontalAlignment="Center" />
          <TextBlock Text="{Binding Principal.Versao}" Foreground="{StaticResource MarcaTextoSuave}" FontSize="12"
                     HorizontalAlignment="Center" />
        </StackPanel>
      </Grid>
    </Border>

    <ScrollViewer Grid.Column="1">
      <Border Classes="cartao" MaxWidth="920" Margin="20" Padding="28" VerticalAlignment="Center">
        <Grid ColumnDefinitions="*,360" RowDefinitions="Auto,*,Auto">
          <StackPanel Grid.ColumnSpan="2" Orientation="Horizontal" Spacing="14" Margin="0,0,0,16">
            <Border Width="56" Height="56" CornerRadius="14" Background="{StaticResource FundoLateral}">
              <PathIcon Data="{StaticResource IconeLoja}" Width="28" Height="28" Foreground="{StaticResource Marca}" />
            </Border>
            <StackPanel VerticalAlignment="Center">
              <TextBlock Classes="titulo">
                <Run Text="Abrir o" />
                <Run Text="{Binding Caixa}" />
              </TextBlock>
              <TextBlock Text="Informe o troco que está na gaveta para começar as vendas." Classes="suave" FontSize="15" />
            </StackPanel>
          </StackPanel>

          <StackPanel Grid.Row="1" Margin="0,0,24,0" VerticalAlignment="Center" Spacing="6">
            <TextBlock Text="Troco Inicial (Abertura de Caixa)" Classes="rotulo" Margin="2,0,0,0" />
            <!-- Em tela pequena (1024 x 600) a letra diminui para o valor inteiro caber (cortava: "R$ 100,0") -->
            <Border Background="{StaticResource Fundo}" CornerRadius="14" Padding="18,10">
              <v:TextoQueCabe Text="{Binding Troco.Texto}" TamanhoMaximo="44" LinhaUnica="True" FontWeight="ExtraBold"
                              TextAlignment="Right" />
            </Border>
            <TextBlock Text="Digite no teclado (5, 0, 0, 0 vira R$ 50,00) ou toque nos valores:" Classes="dica" />
            <UniformGrid Columns="3" Margin="-4,6,-4,0">
              <UniformGrid.Styles>
                <Style Selector="Button.rapido">
                  <Setter Property="Margin" Value="4" />
                  <Setter Property="Height" Value="62" />
                  <Setter Property="HorizontalAlignment" Value="Stretch" />
                  <Setter Property="FontSize" Value="20" />
                  <Setter Property="FontWeight" Value="Bold" />
                  <Setter Property="CornerRadius" Value="12" />
                  <Setter Property="Command" Value="{Binding Troco.SomarCommand}" />
                  <!-- Em tela pequena o valor do botão diminui para caber (cortava: todos viravam "+ R$") -->
                  <Setter Property="Padding" Value="4,0" />
                  <Setter Property="ContentTemplate">
                    <DataTemplate x:DataType="x:String">
                      <v:TextoQueCabe Text="{Binding}" TamanhoMaximo="20" LinhaUnica="True" />
                    </DataTemplate>
                  </Setter>
                </Style>
              </UniformGrid.Styles>
              <Button Classes="suave rapido" Content="+ R$ 1" CommandParameter="100" />
              <Button Classes="suave rapido" Content="+ R$ 5" CommandParameter="500" />
              <Button Classes="suave rapido" Content="+ R$ 10" CommandParameter="1000" />
              <Button Classes="suave rapido" Content="+ R$ 20" CommandParameter="2000" />
              <Button Classes="suave rapido" Content="+ R$ 50" CommandParameter="5000" />
              <Button Classes="suave rapido" Content="+ R$ 100" CommandParameter="10000" />
            </UniformGrid>
          </StackPanel>

          <v:TecladoNumerico Grid.Row="1" Grid.Column="1" Comando="{Binding Troco.TeclaCommand}" TeclaEsquerda="C"
                             Height="320" />

          <Button Grid.Row="2" Grid.ColumnSpan="2" Classes="primario" Command="{Binding AbrirCaixaCommand}"
                  HorizontalAlignment="Stretch" Height="72" Margin="0,24,0,0" CornerRadius="14">
            <StackPanel Orientation="Horizontal" Spacing="12">
              <PathIcon Data="{StaticResource IconeLoja}" Width="28" Height="28" Foreground="White" />
              <TextBlock Text="Abrir caixa" FontSize="24" FontWeight="ExtraBold" Foreground="White" />
            </StackPanel>
          </Button>
        </Grid>
      </Border>
    </ScrollViewer>
  </Grid>
</UserControl>
