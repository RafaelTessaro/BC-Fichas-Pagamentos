<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:BCFichas.App.ViewModels"
             xmlns:v="using:BCFichas.App.Views"
             x:Class="BCFichas.App.Views.MenuView"
             x:DataType="vm:MenuViewModel">
  <Border Classes="cartao" Width="900" Padding="18">
    <Grid RowDefinitions="Auto,*,Auto">
      <Grid ColumnDefinitions="*,Auto" Margin="6,0,0,10">
        <TextBlock Text="Menu" Classes="titulo" VerticalAlignment="Center" />
        <Button Grid.Column="1" Classes="fantasma" Command="{Binding FecharCommand}" Width="52" Height="52" Padding="0">
          <PathIcon Data="{StaticResource IconeFechar}" Width="24" Height="24" />
        </Button>
      </Grid>
      <ItemsControl Grid.Row="1" ItemsSource="{Binding Itens}">
        <ItemsControl.ItemsPanel>
          <ItemsPanelTemplate><UniformGrid Columns="4" /></ItemsPanelTemplate>
        </ItemsControl.ItemsPanel>
        <ItemsControl.ItemTemplate>
          <DataTemplate x:DataType="vm:ItemMenu">
            <Button Classes="menu" Command="{Binding $parent[UserControl].((vm:MenuViewModel)DataContext).EscolherCommand}"
                    CommandParameter="{Binding}" HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch"
                    Padding="14,12">
              <Grid RowDefinitions="Auto,*">
                <Grid ColumnDefinitions="Auto,*">
                  <Border Width="46" Height="46" CornerRadius="12" Background="{Binding Cor}">
                    <PathIcon Data="{Binding Icone}" Width="26" Height="26" Foreground="White" />
                  </Border>
                  <PathIcon Grid.Column="1" Data="{StaticResource IconeCadeado}" IsVisible="{Binding Protegido}"
                            Width="16" Height="16" Foreground="{StaticResource TextoSuave}"
                            HorizontalAlignment="Right" VerticalAlignment="Top" />
                </Grid>
                <StackPanel Grid.Row="1" Margin="0,10,0,0">
                  <!-- Título sempre numa linha: diminui a letra se não couber (ex.: Sangria / Suprimento) -->
                  <v:TextoQueCabe Text="{Binding Titulo}" TamanhoMaximo="17" TamanhoMinimo="13" LinhaUnica="True"
                                  FontWeight="Bold" TextWrapping="NoWrap" />
                  <TextBlock Text="{Binding Descricao}" FontSize="13" Classes="suave" TextWrapping="Wrap" />
                </StackPanel>
              </Grid>
            </Button>
          </DataTemplate>
        </ItemsControl.ItemTemplate>
      </ItemsControl>
      <!-- O telefone do suporte saiu da barra lateral (mais espaço para Sangria e Fechar caixa) -->
      <StackPanel Grid.Row="2" Orientation="Horizontal" Spacing="8" HorizontalAlignment="Center" Margin="0,12,0,0">
        <PathIcon Data="{StaticResource IconeTelefone}" Width="16" Height="16" Foreground="{StaticResource TextoSuave}" />
        <TextBlock Text="{Binding Suporte}" Classes="suave" FontSize="14" FontWeight="SemiBold" VerticalAlignment="Center" />
      </StackPanel>
    </Grid>
  </Border>
</UserControl>
