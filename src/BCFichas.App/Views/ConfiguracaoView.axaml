<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:core="using:BCFichas.Core"
             xmlns:vm="using:BCFichas.App.ViewModels"
             xmlns:v="using:BCFichas.App.Views"
             x:Class="BCFichas.App.Views.ConfiguracaoView"
             x:DataType="vm:ConfiguracaoViewModel">
  <UserControl.Styles>
    <Style Selector="StackPanel.form">
      <Setter Property="MaxWidth" Value="640" />
      <Setter Property="HorizontalAlignment" Value="Left" />
      <Setter Property="Margin" Value="6,6,6,24" />
    </Style>
    <Style Selector="Grid.linha">
      <Setter Property="Margin" Value="0,10,0,0" />
    </Style>

    <!-- Cartões da aba Segurança: verde quando a tela pede senha -->
    <Style Selector="ToggleButton.protecao">
      <Setter Property="Background" Value="{StaticResource Superficie}" />
      <Setter Property="BorderBrush" Value="{StaticResource Borda}" />
      <Setter Property="BorderThickness" Value="2" />
      <Setter Property="CornerRadius" Value="14" />
      <Setter Property="MinHeight" Value="72" />
    </Style>
    <Style Selector="ToggleButton.protecao:pointerover /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="{StaticResource Fundo}" />
      <Setter Property="BorderBrush" Value="#CBD5E1" />
    </Style>
    <Style Selector="ToggleButton.protecao:checked /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="{StaticResource PrimariaClara}" />
      <Setter Property="BorderBrush" Value="{StaticResource Primaria}" />
    </Style>
    <Style Selector="ToggleButton.protecao:disabled /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Opacity" Value="0.5" />
    </Style>
    <Style Selector="ToggleButton.protecao Border.icone">
      <Setter Property="Background" Value="{StaticResource Fundo}" />
    </Style>
    <Style Selector="ToggleButton.protecao Border.icone PathIcon">
      <Setter Property="Foreground" Value="{StaticResource TextoSuave}" />
    </Style>
    <Style Selector="ToggleButton.protecao:checked Border.icone">
      <Setter Property="Background" Value="{StaticResource Primaria}" />
    </Style>
    <Style Selector="ToggleButton.protecao:checked Border.icone PathIcon">
      <Setter Property="Foreground" Value="White" />
    </Style>
    <Style Selector="ToggleButton.protecao Border.situacao">
      <Setter Property="Background" Value="{StaticResource Fundo}" />
    </Style>
    <Style Selector="ToggleButton.protecao:checked Border.situacao">
      <Setter Property="Background" Value="{StaticResource Primaria}" />
    </Style>
    <Style Selector="ToggleButton.protecao :is(Control).travada">
      <Setter Property="IsVisible" Value="False" />
    </Style>
    <Style Selector="ToggleButton.protecao:checked :is(Control).travada">
      <Setter Property="IsVisible" Value="True" />
    </Style>
    <Style Selector="ToggleButton.protecao:checked TextBlock.travada">
      <Setter Property="Foreground" Value="White" />
    </Style>
    <Style Selector="ToggleButton.protecao:checked PathIcon.travada">
      <Setter Property="Foreground" Value="White" />
    </Style>
    <Style Selector="ToggleButton.protecao:checked TextBlock.livre">
      <Setter Property="IsVisible" Value="False" />
    </Style>
    <Style Selector="ToggleButton.protecao TextBlock.livre">
      <Setter Property="Foreground" Value="{StaticResource TextoSuave}" />
    </Style>
  </UserControl.Styles>

  <Grid RowDefinitions="Auto,*">
    <Border Classes="cabecalho">
      <Grid ColumnDefinitions="Auto,*,Auto">
        <Button Classes="fantasma" Command="{Binding VoltarCommand}" Height="48" Padding="12,0">
          <StackPanel Orientation="Horizontal" Spacing="8">
            <PathIcon Data="{StaticResource IconeVoltar}" />
            <TextBlock Text="Voltar" VerticalAlignment="Center" />
          </StackPanel>
        </Button>
        <TextBlock Grid.Column="1" Text="Configurações" Classes="titulo" VerticalAlignment="Center" Margin="10,0" />
        <Button Grid.Column="2" Classes="primario" Command="{Binding SalvarCommand}" Height="48" Padding="30,0">
          <StackPanel Orientation="Horizontal" Spacing="8">
            <PathIcon Data="{StaticResource IconeOk}" Foreground="White" />
            <TextBlock Text="Salvar" Foreground="White" FontSize="17" VerticalAlignment="Center" />
          </StackPanel>
        </Button>
      </Grid>
    </Border>

    <Border Grid.Row="1" Classes="cartao" Margin="14" Padding="12,4,12,12">
      <TabControl SelectedIndex="{Binding AbaSelecionada}">

        <!-- GERAL -->
        <TabItem Header="Geral">
          <ScrollViewer>
            <StackPanel Classes="form">
              <TextBlock Text="Nome do evento / festa" Classes="rotulo" />
              <TextBox Text="{Binding NomeEvento}" MaxLength="40" Watermark="Ex.: FESTA JUNINA SÃO JOÃO" />
              <TextBlock Text="Sai em cada ficha e nos relatórios." Classes="dica" />

              <TextBlock Text="Rodapé da ficha (opcional)" Classes="rotulo" />
              <TextBox Text="{Binding Rodape}" MaxLength="80" Watermark="Ex.: OBRIGADO E VOLTE SEMPRE!" />
              <TextBlock Classes="dica" TextWrapping="Wrap">
                <Run Text="Sai no fim de cada ficha. Embaixo dele sai sempre a linha" />
                <Run Text="{x:Static core:Configuracao.MensagemFixa}" FontWeight="SemiBold" />
              </TextBlock>

              <Grid Classes="linha" ColumnDefinitions="*,16,*">
                <StackPanel>
                  <TextBlock Text="Número deste caixa" Classes="rotulo" />
                  <ComboBox ItemsSource="{Binding Caixas}" SelectedItem="{Binding NumeroCaixa}" />
                </StackPanel>
                <StackPanel Grid.Column="2">
                  <TextBlock Text="Tamanho da tela" Classes="rotulo" />
                  <ComboBox ItemsSource="{Binding Zooms}" SelectedItem="{Binding Zoom}">
                    <ComboBox.ItemTemplate>
                      <DataTemplate x:DataType="x:Int32">
                        <TextBlock Text="{Binding StringFormat={}{0}%}" />
                      </DataTemplate>
                    </ComboBox.ItemTemplate>
                  </ComboBox>
                </StackPanel>
              </Grid>

              <Grid Classes="linha" ColumnDefinitions="*,Auto">
                <StackPanel>
                  <TextBlock Text="Tela cheia" FontWeight="SemiBold" FontSize="16" />
                  <TextBlock Text="Esconde a barra do Windows (modo quiosque)." Classes="dica" />
                </StackPanel>
                <ToggleSwitch Grid.Column="1" IsChecked="{Binding TelaCheia}" />
              </Grid>
              <Grid Classes="linha" ColumnDefinitions="*,Auto">
                <StackPanel>
                  <TextBlock Text="Teclado na tela" FontWeight="SemiBold" FontSize="16" />
                  <TextBlock Text="Mostra um teclado ao tocar num campo de texto." Classes="dica" />
                </StackPanel>
                <ToggleSwitch Grid.Column="1" IsChecked="{Binding TecladoNaTela}" />
              </Grid>
              <Grid Classes="linha" ColumnDefinitions="*,Auto">
                <StackPanel>
                  <TextBlock Text="Manter a tela sempre ligada" FontWeight="SemiBold" FontSize="16" />
                  <TextBlock Text="Com o programa aberto, o Windows não apaga a tela nem suspende o tablet." Classes="dica" />
                </StackPanel>
                <ToggleSwitch Grid.Column="1" IsChecked="{Binding ManterTelaLigada}" />
              </Grid>
              <Grid Classes="linha" ColumnDefinitions="*,Auto">
                <StackPanel>
                  <TextBlock Text="Abrir o BC Fichas quando o Windows ligar" FontWeight="SemiBold" FontSize="16" />
                  <TextBlock Text="O programa abre sozinho depois que o Windows entra." Classes="dica" />
                </StackPanel>
                <ToggleSwitch Grid.Column="1" IsChecked="{Binding IniciarComWindows}" />
              </Grid>
              <Grid Classes="linha" ColumnDefinitions="*,Auto">
                <StackPanel>
                  <TextBlock Text="Desligar o computador ao fechar o caixa" FontWeight="SemiBold" FontSize="16" />
                  <TextBlock Text="Depois de imprimir o fechamento." Classes="dica" />
                </StackPanel>
                <ToggleSwitch Grid.Column="1" IsChecked="{Binding DesligarAoFechar}" />
              </Grid>

              <TextBlock Text="Pasta dos dados (para backup, copie esta pasta)" Classes="rotulo" Margin="2,20,0,4" />
              <SelectableTextBlock Text="{Binding PastaDados}" Classes="suave" TextWrapping="Wrap" />
            </StackPanel>
          </ScrollViewer>
        </TabItem>

        <!-- FICHA -->
        <TabItem Header="Ficha">
          <Grid ColumnDefinitions="*,Auto">
            <ScrollViewer>
              <StackPanel Classes="form">
                <TextBlock Text="Modelo da ficha" Classes="rotulo" />
                <ComboBox ItemsSource="{Binding Modelos}" SelectedItem="{Binding Modelo}">
                </ComboBox>

                <TextBlock Text="Fonte do nome do produto" Classes="rotulo" />
                <ComboBox ItemsSource="{Binding Fontes}" SelectedItem="{Binding Fonte}" MaxDropDownHeight="360" />

                <Grid Classes="linha" ColumnDefinitions="*,Auto">
                  <TextBlock Text="Borda em volta da ficha" FontWeight="SemiBold" FontSize="16" VerticalAlignment="Center" />
                  <ToggleSwitch Grid.Column="1" IsChecked="{Binding Moldura}" />
                </Grid>
                <Grid Classes="linha" ColumnDefinitions="*,Auto">
                  <TextBlock Text="Mostrar o valor na ficha" FontWeight="SemiBold" FontSize="16" VerticalAlignment="Center" />
                  <ToggleSwitch Grid.Column="1" IsChecked="{Binding MostrarValor}" />
                </Grid>
                <Grid Classes="linha" ColumnDefinitions="*,Auto">
                  <StackPanel>
                    <TextBlock Text="Código de barras" FontWeight="SemiBold" FontSize="16" />
                    <TextBlock Text="Número único de cada ficha, para conferência." Classes="dica" />
                  </StackPanel>
                  <ToggleSwitch Grid.Column="1" IsChecked="{Binding CodigoDeBarras}" />
                </Grid>

                <TextBlock Text="Logotipo do evento (ideal: desenho preto e branco)" Classes="rotulo" Margin="2,16,0,4" />
                <StackPanel Orientation="Horizontal" Spacing="8">
                  <Button Classes="suave" Command="{Binding EscolherLogoCommand}">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                      <PathIcon Data="{StaticResource IconeImagem}" />
                      <TextBlock Text="Escolher imagem" VerticalAlignment="Center" />
                    </StackPanel>
                  </Button>
                  <Button Classes="fantasma" Content="Tirar logo" Command="{Binding RemoverLogoCommand}"
                          IsVisible="{Binding TemLogo}" />
                </StackPanel>
                <TextBlock Text="Imagens simples (preto e branco) ficam melhores na impressora térmica." Classes="dica" />
              </StackPanel>
            </ScrollViewer>

            <Border Grid.Column="1" Background="{StaticResource Fundo}" CornerRadius="12" Padding="14" Margin="8,6,4,6"
                    Width="420">
              <Grid RowDefinitions="Auto,*">
                <TextBlock Text="Prévia (como sai no papel)" Classes="rotulo" Margin="2,0,0,8" />
                <ScrollViewer Grid.Row="1">
                  <Border Background="White" BoxShadow="0 2 8 0 #330F172A" HorizontalAlignment="Center" VerticalAlignment="Top">
                    <Image Source="{Binding Previa}" Width="384" Stretch="Uniform" />
                  </Border>
                </ScrollViewer>
              </Grid>
            </Border>
          </Grid>
        </TabItem>

        <!-- BOTÕES E ABAS -->
        <TabItem Header="Botões e abas">
          <ScrollViewer>
            <StackPanel Classes="form">
              <TextBlock Text="Tamanho da grade de botões" Classes="secao" />
              <Grid ColumnDefinitions="*,16,*">
                <StackPanel>
                  <TextBlock Text="Colunas" Classes="rotulo" />
                  <ComboBox ItemsSource="{Binding OpcoesGrade}" SelectedItem="{Binding Colunas}" />
                </StackPanel>
                <StackPanel Grid.Column="2">
                  <TextBlock Text="Linhas" Classes="rotulo" />
                  <ComboBox ItemsSource="{Binding OpcoesGrade}" SelectedItem="{Binding Linhas}" />
                </StackPanel>
              </Grid>
              <TextBlock Classes="dica" Text="Cada aba mostra colunas × linhas botões (ex.: 4 × 3 = 12)." />

              <Grid ColumnDefinitions="*,Auto" Margin="0,22,0,6">
                <TextBlock Text="Abas da tela de venda" Classes="secao" VerticalAlignment="Center" />
                <Button Grid.Column="1" Classes="suave" Command="{Binding NovaAbaCommand}">
                  <StackPanel Orientation="Horizontal" Spacing="6">
                    <PathIcon Data="{StaticResource IconeMais}" />
                    <TextBlock Text="Nova aba" VerticalAlignment="Center" />
                  </StackPanel>
                </Button>
              </Grid>
              <ItemsControl ItemsSource="{Binding Abas}">
                <ItemsControl.ItemTemplate>
                  <DataTemplate x:DataType="vm:AbaEdicao">
                    <Grid ColumnDefinitions="*,Auto,Auto,Auto" Margin="0,0,0,8">
                      <TextBox Text="{Binding Nome}" MaxLength="20" />
                      <Button Grid.Column="1" Classes="fantasma" Width="48" Padding="0" Margin="6,0,0,0"
                              Command="{Binding $parent[UserControl].((vm:ConfiguracaoViewModel)DataContext).SubirAbaCommand}"
                              CommandParameter="{Binding}">
                        <PathIcon Data="{StaticResource IconeSetaCima}" />
                      </Button>
                      <Button Grid.Column="2" Classes="fantasma" Width="48" Padding="0"
                              Command="{Binding $parent[UserControl].((vm:ConfiguracaoViewModel)DataContext).DescerAbaCommand}"
                              CommandParameter="{Binding}">
                        <PathIcon Data="{StaticResource IconeSetaBaixo}" />
                      </Button>
                      <Button Grid.Column="3" Classes="fantasma" Width="48" Padding="0"
                              Command="{Binding $parent[UserControl].((vm:ConfiguracaoViewModel)DataContext).ExcluirAbaCommand}"
                              CommandParameter="{Binding}">
                        <PathIcon Data="{StaticResource IconeLixo}" Foreground="{StaticResource Perigo}" />
                      </Button>
                    </Grid>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
              <TextBlock Classes="dica" Text="Os nomes das abas são gravados ao tocar em Salvar. Com uma aba só, a barra de abas fica escondida." />

              <TextBlock Text="Pasta das fotos dos produtos" Classes="secao" Margin="0,22,0,4" />
              <TextBox Text="{Binding PastaFotos}" MaxLength="200" Watermark="C:\Sistema_New\produtos" />
              <TextBlock Classes="dica" Text="O botão Imagem do cadastro de produtos sempre começa nesta pasta." />
            </StackPanel>
          </ScrollViewer>
        </TabItem>

        <!-- IMPRESSORA -->
        <TabItem Header="Impressora">
          <ScrollViewer>
            <StackPanel Classes="form">
              <TextBlock Text="Como a impressora está ligada" Classes="rotulo" />
              <ComboBox ItemsSource="{Binding TiposImpressora}" SelectedItem="{Binding TipoImpressora}">
              </ComboBox>

              <StackPanel IsVisible="{Binding ImpressoraWindows}">
                <TextBlock Text="Impressora" Classes="rotulo" />
                <ComboBox ItemsSource="{Binding Impressoras}" SelectedItem="{Binding NomeImpressora}" />
                <TextBlock Classes="dica" IsVisible="{Binding SemImpressoras}" Foreground="{StaticResource Perigo}"
                           Text="Nenhuma impressora instalada no Windows. Instale o driver da Elgin i9 e volte nesta aba." />
                <TextBlock Classes="dica"
                           Text="A lista de impressoras do Windows é atualizada sozinha sempre que você abre esta aba." />
              </StackPanel>

              <StackPanel IsVisible="{Binding ImpressoraSerial}">
                <Grid ColumnDefinitions="*,16,*">
                  <StackPanel>
                    <TextBlock Text="Porta" Classes="rotulo" />
                    <ComboBox ItemsSource="{Binding Portas}" SelectedItem="{Binding PortaSerial}" />
                  </StackPanel>
                  <StackPanel Grid.Column="2">
                    <TextBlock Text="Velocidade" Classes="rotulo" />
                    <ComboBox ItemsSource="{Binding Velocidades}" SelectedItem="{Binding BaudRate}" />
                  </StackPanel>
                </Grid>
                <TextBlock Classes="dica" Text="Veja a porta no Gerenciador de Dispositivos do Windows (Portas COM e LPT)." />
              </StackPanel>

              <StackPanel IsVisible="{Binding ImpressoraArquivo}">
                <TextBlock Text="As fichas serão salvas como imagens em:" Classes="rotulo" />
                <SelectableTextBlock Text="{Binding PastaArquivo}" Classes="suave" TextWrapping="Wrap" />
              </StackPanel>

              <Grid Classes="linha" ColumnDefinitions="*,16,*">
                <StackPanel>
                  <TextBlock Text="Largura do papel" Classes="rotulo" />
                  <ComboBox ItemsSource="{Binding Papeis}" SelectedItem="{Binding LarguraPapel}">
                    <ComboBox.ItemTemplate>
                      <DataTemplate x:DataType="x:Int32">
                        <TextBlock Text="{Binding StringFormat={}{0} mm}" />
                      </DataTemplate>
                    </ComboBox.ItemTemplate>
                  </ComboBox>
                </StackPanel>
              </Grid>
              <TextBlock Text="Guilhotina depois de cada ficha" Classes="rotulo" />
              <ComboBox ItemsSource="{Binding Cortes}" SelectedItem="{Binding Corte}" />

              <TextBlock Text="Posição da impressão no papel" Classes="rotulo" Margin="2,18,0,4" />
              <Grid ColumnDefinitions="Auto,*,Auto,Auto">
                <Button Classes="suave" Width="64" Height="52" Padding="0" Command="{Binding MoverImpressaoCommand}"
                        CommandParameter="esquerda" ToolTip.Tip="Puxar para a esquerda">
                  <PathIcon Data="{StaticResource IconeVoltar}" />
                </Button>
                <Border Grid.Column="1" Background="{StaticResource Fundo}" CornerRadius="10" Margin="8,0" Height="52">
                  <TextBlock Text="{Binding AjusteTexto}" FontSize="18" FontWeight="Bold" HorizontalAlignment="Center"
                             VerticalAlignment="Center" />
                </Border>
                <Button Grid.Column="2" Classes="suave" Width="64" Height="52" Padding="0" Command="{Binding MoverImpressaoCommand}"
                        CommandParameter="direita" ToolTip.Tip="Puxar para a direita">
                  <PathIcon Data="{StaticResource IconeVoltar}" RenderTransform="rotate(180deg)" />
                </Button>
                <Button Grid.Column="3" Classes="fantasma" Content="Centralizar" Margin="8,0,0,0" Height="52"
                        Command="{Binding MoverImpressaoCommand}" CommandParameter="centro" />
              </Grid>
              <TextBlock Classes="dica"
                         Text="Se a ficha sai mais para um lado do papel, puxe para o outro lado (meio milímetro por toque) e imprima um teste até a borda ficar com a mesma folga dos dois lados." />

              <Button Classes="primario" Command="{Binding ImprimirTesteCommand}" Height="56" Margin="0,22,0,0"
                      HorizontalAlignment="Left" Padding="28,0" IsEnabled="{Binding !ImprimindoTeste}">
                <StackPanel Orientation="Horizontal" Spacing="10">
                  <PathIcon Data="{StaticResource IconeImpressora}" Foreground="White" />
                  <TextBlock Text="Imprimir teste" Foreground="White" FontSize="17" VerticalAlignment="Center" />
                </StackPanel>
              </Button>
              <TextBlock Classes="dica" Text="O teste usa o que está nesta tela, mesmo antes de salvar." />
            </StackPanel>
          </ScrollViewer>
        </TabItem>

        <!-- MAQUININHA -->
        <TabItem Header="Maquininha">
          <ScrollViewer>
            <StackPanel Classes="form">
              <TextBlock Text="Como o cartão e o PIX são cobrados" Classes="rotulo" />
              <ComboBox ItemsSource="{Binding TiposMaquininha}" SelectedItem="{Binding TipoMaquininha}" />

              <Border Background="{StaticResource PrimariaClara}" CornerRadius="12" Padding="16" Margin="0,14,0,0"
                      IsVisible="{Binding !MaquininhaSimulador}">
                <StackPanel Spacing="6">
                  <TextBlock Text="Maquininha separada (como funciona hoje)" FontWeight="Bold" FontSize="17" />
                  <TextBlock TextWrapping="Wrap" FontSize="15"
                             Text="No pagamento com Débito, Crédito ou PIX, o programa mostra o valor para passar na maquininha. Quando ela aprovar, o operador toca em APROVADO NA MAQUININHA e as fichas saem. A forma de pagamento fica registrada nos relatórios e no fechamento." />
                  <TextBlock TextWrapping="Wrap" FontSize="14" Classes="suave"
                             Text="A ligação direta com a maquininha (Bluetooth / cabo) entra aqui como mais uma opção quando estiver pronta; o resto do programa já está preparado para ela." />
                </StackPanel>
              </Border>

              <StackPanel IsVisible="{Binding MaquininhaSimulador}">
                <Border Background="{StaticResource AvisoClara}" CornerRadius="12" Padding="16" Margin="0,14,0,0">
                  <StackPanel Spacing="6">
                    <TextBlock Text="Modo simulador" FontWeight="Bold" FontSize="17" />
                    <TextBlock TextWrapping="Wrap" FontSize="15"
                               Text="Para treinar: no pagamento com cartão ou PIX aparecem os botões 'Simular aprovado' e 'Simular recusado'." />
                  </StackPanel>
                </Border>
                <TextBlock Text="Aprovar sozinho depois de" Classes="rotulo" Margin="2,16,0,4" />
                <ComboBox ItemsSource="{Binding SegundosSimulador}" SelectedItem="{Binding SimuladorSegundos}">
                  <ComboBox.ItemTemplate>
                    <DataTemplate x:DataType="x:Int32">
                      <TextBlock Text="{Binding Converter={x:Static v:Conversores.Segundos}}" />
                    </DataTemplate>
                  </ComboBox.ItemTemplate>
                </ComboBox>
              </StackPanel>
            </StackPanel>
          </ScrollViewer>
        </TabItem>

        <!-- SEGURANÇA -->
        <TabItem Header="Segurança">
          <ScrollViewer>
            <StackPanel Margin="6,6,6,24" MaxWidth="900" HorizontalAlignment="Left" Spacing="16">

              <!-- Senha master -->
              <Border Background="{StaticResource Fundo}" CornerRadius="14" Padding="18">
                <Grid ColumnDefinitions="Auto,*,Auto">
                  <Border Width="56" Height="56" CornerRadius="14" Background="{StaticResource Primaria}"
                          IsVisible="{Binding TemSenha}">
                    <PathIcon Data="{StaticResource IconeCadeado}" Width="28" Height="28" Foreground="White" />
                  </Border>
                  <Border Width="56" Height="56" CornerRadius="14" Background="{StaticResource AvisoClara}"
                          IsVisible="{Binding SemSenha}">
                    <PathIcon Data="{StaticResource IconeAlerta}" Width="28" Height="28" Foreground="{StaticResource Aviso}" />
                  </Border>
                  <StackPanel Grid.Column="1" Margin="14,0" VerticalAlignment="Center" Spacing="2">
                    <TextBlock Text="Senha master" FontSize="19" FontWeight="Bold" />
                    <TextBlock IsVisible="{Binding TemSenha}" Classes="suave" FontSize="15" TextWrapping="Wrap"
                               Text="Senha definida. As telas marcadas abaixo pedem a senha para abrir." />
                    <TextBlock IsVisible="{Binding SemSenha}" Foreground="{StaticResource Aviso}" FontSize="15" TextWrapping="Wrap"
                               Text="Sem senha: qualquer pessoa abre todas as telas." />
                  </StackPanel>
                  <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                    <Button Classes="fantasma" Content="Tirar senha" Command="{Binding RemoverSenhaCommand}"
                            IsVisible="{Binding TemSenha}" Foreground="{StaticResource Perigo}" />
                    <Button Classes="primario" Command="{Binding DefinirSenhaCommand}" Height="52" Padding="22,0">
                      <StackPanel Orientation="Horizontal" Spacing="8">
                        <PathIcon Data="{StaticResource IconeCadeado}" Foreground="White" Width="20" Height="20" />
                        <TextBlock Text="Criar senha" Foreground="White" IsVisible="{Binding SemSenha}" />
                        <TextBlock Text="Trocar senha" Foreground="White" IsVisible="{Binding TemSenha}" />
                      </StackPanel>
                    </Button>
                  </StackPanel>
                </Grid>
              </Border>

              <!-- Telas travadas -->
              <StackPanel Spacing="4">
                <Grid ColumnDefinitions="*,Auto,Auto">
                  <StackPanel>
                    <TextBlock Text="Telas que pedem a senha" Classes="secao" Margin="0" />
                    <TextBlock Text="Toque numa tela para travar ou liberar. Grava ao tocar em Salvar." Classes="dica" Margin="0" />
                  </StackPanel>
                  <Button Grid.Column="1" Classes="fantasma" Content="Travar todas" Command="{Binding TravarTudoCommand}"
                          IsEnabled="{Binding TemSenha}" VerticalAlignment="Center" />
                  <Button Grid.Column="2" Classes="fantasma" Content="Liberar todas" Command="{Binding LiberarTudoCommand}"
                          IsEnabled="{Binding TemSenha}" VerticalAlignment="Center" />
                </Grid>
                <ItemsControl ItemsSource="{Binding Protecoes}" IsEnabled="{Binding TemSenha}" Margin="-5,6,-5,0">
                  <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate><UniformGrid Columns="2" /></ItemsPanelTemplate>
                  </ItemsControl.ItemsPanel>
                  <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="vm:ProtecaoTela">
                      <ToggleButton Classes="protecao" IsChecked="{Binding Marcada}" Margin="5" Padding="14,10"
                                    HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch">
                        <Grid ColumnDefinitions="Auto,*,Auto">
                          <Border Classes="icone" Width="44" Height="44" CornerRadius="12">
                            <PathIcon Data="{Binding Icone}" Width="24" Height="24" />
                          </Border>
                          <StackPanel Grid.Column="1" Margin="12,0" VerticalAlignment="Center">
                            <TextBlock Text="{Binding Nome}" FontSize="16" FontWeight="Bold" />
                            <TextBlock Text="{Binding Descricao}" FontSize="13" Classes="suave" />
                          </StackPanel>
                          <Border Grid.Column="2" Classes="situacao" CornerRadius="999" Padding="10,4" VerticalAlignment="Center">
                            <StackPanel Orientation="Horizontal" Spacing="5">
                              <PathIcon Classes="travada" Data="{StaticResource IconeCadeado}" Width="14" Height="14" />
                              <TextBlock Classes="travada" Text="Pede senha" FontSize="13" FontWeight="Bold" />
                              <TextBlock Classes="livre" Text="Livre" FontSize="13" FontWeight="SemiBold" />
                            </StackPanel>
                          </Border>
                        </Grid>
                      </ToggleButton>
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>
                <TextBlock Classes="dica" IsVisible="{Binding SemSenha}" Text="Crie uma senha para poder travar as telas." />
              </StackPanel>
            </StackPanel>
          </ScrollViewer>
        </TabItem>
      </TabControl>
    </Border>
  </Grid>
</UserControl>
