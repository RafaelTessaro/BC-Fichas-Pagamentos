<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:BCFichas.App.ViewModels"
             xmlns:v="using:BCFichas.App.Views"
             x:Class="BCFichas.App.Views.NovaSenhaView"
             x:DataType="vm:NovaSenhaViewModel">
  <Border Classes="cartao" Width="400" Padding="22">
    <StackPanel Spacing="12">
      <StackPanel Orientation="Horizontal" Spacing="10" HorizontalAlignment="Center">
        <PathIcon Data="{StaticResource IconeCadeado}" Width="26" Height="26" />
        <TextBlock Text="Nova senha master" Classes="titulo" FontSize="22" />
      </StackPanel>
      <TextBlock Text="{Binding Instrucao}" HorizontalAlignment="Center" Classes="suave" FontSize="15" />
      <Border Background="{StaticResource Fundo}" CornerRadius="12" Height="60">
        <TextBlock Text="{Binding Pontos}" FontSize="30" HorizontalAlignment="Center" VerticalAlignment="Center"
                   LetterSpacing="6" />
      </Border>
      <TextBlock Text="{Binding Erro}" Foreground="{StaticResource Perigo}" FontWeight="Bold" HorizontalAlignment="Center"
                 TextWrapping="Wrap" TextAlignment="Center"
                 IsVisible="{Binding Erro, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
      <v:TecladoNumerico Comando="{Binding TeclaCommand}" TeclaEsquerda="C" Height="260" />
      <Grid ColumnDefinitions="*,*">
        <Button Classes="suave" Content="Cancelar" Command="{Binding CancelarCommand}" HorizontalAlignment="Stretch"
                Height="56" Margin="0,0,6,0" />
        <Button Grid.Column="1" Classes="primario" Content="{Binding TextoBotao}" Command="{Binding ConfirmarCommand}"
                HorizontalAlignment="Stretch" Height="56" Margin="6,0,0,0" FontSize="18" />
      </Grid>
    </StackPanel>
  </Border>
</UserControl>
