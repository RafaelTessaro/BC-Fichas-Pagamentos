<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:BCFichas.App.ViewModels"
             x:Class="BCFichas.App.Views.ResumoCaixaView"
             x:DataType="vm:ResumoVM">
  <UserControl.Styles>
    <Style Selector="Border.numero">
      <Setter Property="Background" Value="{StaticResource Superficie}" />
      <Setter Property="CornerRadius" Value="14" />
      <Setter Property="Padding" Value="16,12" />
      <Setter Property="Margin" Value="5" />
      <Setter Property="BoxShadow" Value="0 1 3 0 #1A0F172A" />
    </Style>
    <Style Selector="Border.numero TextBlock.legenda">
      <Setter Property="FontSize" Value="13" />
      <Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="Foreground" Value="{StaticResource TextoSuave}" />
    </Style>
    <Style Selector="TextBlock.forte">
      <Setter Property="FontWeight" Value="ExtraBold" />
    </Style>
    <Style Selector="Border.numero TextBlock.grande">
      <Setter Property="FontSize" Value="26" />
      <Setter Property="FontWeight" Value="ExtraBold" />
    </Style>
  </UserControl.Styles>

  <StackPanel Spacing="6">
    <StackPanel Margin="6,0,0,4">
      <TextBlock Text="{Binding Titulo}" FontSize="20" FontWeight="Bold" />
      <TextBlock Text="{Binding Periodo}" Classes="suave" />
    </StackPanel>

    <UniformGrid Columns="4">
      <Border Classes="numero">
        <StackPanel>
          <TextBlock Classes="legenda" Text="TOTAL VENDIDO" />
          <TextBlock Classes="grande" Text="{Binding TotalVendido}" Foreground="{StaticResource PrimariaEscura}" />
        </StackPanel>
      </Border>
      <Border Classes="numero">
        <StackPanel>
          <TextBlock Classes="legenda" Text="PEDIDOS" />
          <TextBlock Classes="grande" Text="{Binding Pedidos}" />
        </StackPanel>
      </Border>
      <Border Classes="numero">
        <StackPanel>
          <TextBlock Classes="legenda" Text="FICHAS" />
          <TextBlock Classes="grande" Text="{Binding Fichas}" />
        </StackPanel>
      </Border>
      <Border Classes="numero">
        <StackPanel>
          <TextBlock Classes="legenda" Text="TICKET MÉDIO" />
          <TextBlock Classes="grande" Text="{Binding TicketMedio}" />
        </StackPanel>
      </Border>
    </UniformGrid>

    <Grid ColumnDefinitions="*,*">
      <Border Classes="numero">
        <StackPanel>
          <TextBlock Text="Por forma de pagamento" Classes="secao" />
          <ItemsControl ItemsSource="{Binding Formas}">
            <ItemsControl.ItemTemplate>
              <DataTemplate x:DataType="vm:LinhaValor">
                <Grid ColumnDefinitions="*,Auto" Margin="0,5">
                  <StackPanel>
                    <TextBlock Text="{Binding Nome}" FontSize="16" FontWeight="SemiBold" />
                    <TextBlock Text="{Binding Detalhe}" FontSize="12" Classes="suave" />
                  </StackPanel>
                  <TextBlock Grid.Column="1" Text="{Binding Valor}" FontSize="18" FontWeight="Bold" VerticalAlignment="Center" />
                </Grid>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </StackPanel>
      </Border>
      <Border Grid.Column="1" Classes="numero">
        <StackPanel>
          <TextBlock Text="Dinheiro na gaveta" Classes="secao" />
          <ItemsControl ItemsSource="{Binding Gaveta}">
            <ItemsControl.ItemTemplate>
              <DataTemplate x:DataType="vm:LinhaValor">
                <Grid ColumnDefinitions="*,Auto" Margin="0,6">
                  <TextBlock Text="{Binding Nome}" FontSize="16" Classes.forte="{Binding Destaque}" />
                  <TextBlock Grid.Column="1" Text="{Binding Valor}" FontSize="17" Classes.forte="{Binding Destaque}" />
                </Grid>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </StackPanel>
      </Border>
    </Grid>

    <!-- Fichas devolvidas (só aparece quando houve devolução neste caixa) -->
    <Border Classes="numero" IsVisible="{Binding TemDevolucoes}">
      <StackPanel>
        <Grid ColumnDefinitions="*,Auto">
          <TextBlock Text="Fichas devolvidas" Classes="secao" />
          <TextBlock Grid.Column="1" Text="{Binding TotalDevolvido}" FontSize="18" FontWeight="Bold"
                     Foreground="{StaticResource Perigo}" />
        </Grid>
        <ItemsControl ItemsSource="{Binding Devolucoes}">
          <ItemsControl.ItemTemplate>
            <DataTemplate x:DataType="vm:LinhaValor">
              <Grid ColumnDefinitions="*,Auto" Margin="0,4">
                <StackPanel>
                  <TextBlock Text="{Binding Nome}" FontSize="16" FontWeight="SemiBold" />
                  <TextBlock Text="{Binding Detalhe}" FontSize="12" Classes="suave" />
                </StackPanel>
                <TextBlock Grid.Column="1" Text="{Binding Valor}" FontSize="16" FontWeight="Bold" VerticalAlignment="Center" />
              </Grid>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
        <Grid ColumnDefinitions="*,Auto" Margin="0,8,0,0">
          <TextBlock Text="Venda líquida (vendido − devolvido)" FontSize="16" FontWeight="ExtraBold" />
          <TextBlock Grid.Column="1" Text="{Binding VendaLiquida}" FontSize="20" FontWeight="ExtraBold"
                     Foreground="{StaticResource PrimariaEscura}" />
        </Grid>
      </StackPanel>
    </Border>

    <Border Classes="numero">
      <StackPanel>
        <TextBlock Text="Produtos vendidos" Classes="secao" />
        <TextBlock Text="Nenhuma venda ainda." Classes="suave" IsVisible="{Binding SemProdutos}" />
        <ItemsControl ItemsSource="{Binding Produtos}">
          <ItemsControl.ItemTemplate>
            <DataTemplate x:DataType="vm:LinhaValor">
              <Border BorderBrush="{StaticResource Borda}" BorderThickness="0,0,0,1" Padding="0,7">
                <Grid ColumnDefinitions="*,100,120">
                  <TextBlock Text="{Binding Nome}" FontSize="16" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                  <TextBlock Grid.Column="1" Text="{Binding Detalhe}" FontSize="16" Classes="suave" TextAlignment="Right" />
                  <TextBlock Grid.Column="2" Text="{Binding Valor}" FontSize="16" FontWeight="Bold" TextAlignment="Right" />
                </Grid>
              </Border>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
      </StackPanel>
    </Border>
  </StackPanel>
</UserControl>
